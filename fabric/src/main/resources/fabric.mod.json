{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": ["com.ifels.cfx.emi.fabric.CfxEmiMod"]
  },
  "depends": {
    "fabricloader": "${fabric_loader_version}",
    "fabric-api": "${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "controlflex": "${controlflex_version_range}",
    "emi": "${emi_version_range}"
  }
}
